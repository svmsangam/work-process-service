PROJECT_NAME="AI-Assisted Work Intake System"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/work_intake

# LLM Settings
# One of: mock | groq | gemini | openrouter | local
AI_PROVIDER=mock
GROQ_API_KEY=
GEMINI_API_KEY=

# OpenRouter settings (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
YOUR_SITE_URL=http://localhost:5173
YOUR_SITE_NAME=WorkProcessAnalysis

# Local OpenAI-compatible endpoint settings (used when AI_PROVIDER=local, e.g. Ollama)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3
